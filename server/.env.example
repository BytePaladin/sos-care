# ==========================================================
# S.O.S. Backend — Environment Variables
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — NEVER commit real secrets.
# ==========================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas (Free Tier M0) ---
# Get from: Atlas dashboard -> Connect -> Drivers -> Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sos_care?retryWrites=true&w=majority

# --- JWT ---
# Generate a strong secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# --- Security ---
BCRYPT_SALT_ROUNDS=10
OTP_TTL_MINUTES=5

# --- CORS ---
# The Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173
