# ---------------------------------------------------------------
# S.O.S. Care — Backend environment variables
# এই ফাইলটি copy করে `.env` নাম দিন, তারপর নিজের মান বসান।
# `.env` কখনো git-এ push করবেন না (.gitignore-এ আগেই আছে)।
# ---------------------------------------------------------------

# Express server কোন port-এ চলবে (vite proxy 5000 আশা করে)
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/sos-care
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sos-care
MONGODB_URI=mongodb://127.0.0.1:27017/sos-care

# JWT signing secret — production-এ অবশ্যই লম্বা random string দিন
JWT_SECRET=change-this-to-a-long-random-string

# Flask ML microservice-এর ঠিকানা (Imtiaz-এর অংশ)
# service না চললেও backend চলবে — fallback heuristic ব্যবহার করবে
ML_SERVICE_URL=http://127.0.0.1:5001

# ML service কত ms পর্যন্ত অপেক্ষা করবে
ML_TIMEOUT_MS=4000

# development / production
NODE_ENV=development
